<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.jxc.mapper.JxcMemberMapper">
    
    <resultMap type="JxcMember" id="JxcMemberResult">
        <result property="id"    column="id"    />
        <result property="memberNo"    column="member_no"    />
        <result property="memberName"    column="member_name"    />
        <result property="phone"    column="phone"    />
        <result property="level"    column="level"    />
        <result property="discount"    column="discount"    />
        <result property="points"    column="points"    />
        <result property="balance"    column="balance"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectJxcMemberVo">
        select id, member_no, member_name, phone, level, discount, points, balance, status, create_by, create_time, update_by, update_time, remark from jxc_member
    </sql>

    <select id="selectJxcMemberList" parameterType="JxcMember" resultMap="JxcMemberResult">
        <include refid="selectJxcMemberVo"/>
        <where>  
            <if test="memberNo != null  and memberNo != ''"> and member_no = #{memberNo}</if>
            <if test="memberName != null  and memberName != ''"> and member_name like concat('%', #{memberName}, '%')</if>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="level != null  and level != ''"> and level = #{level}</if>
            <if test="discount != null "> and discount = #{discount}</if>
            <if test="points != null "> and points = #{points}</if>
            <if test="balance != null "> and balance = #{balance}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectJxcMemberById" parameterType="Long" resultMap="JxcMemberResult">
        <include refid="selectJxcMemberVo"/>
        where id = #{id}
    </select>

    <insert id="insertJxcMember" parameterType="JxcMember" useGeneratedKeys="true" keyProperty="id">
        insert into jxc_member
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="memberNo != null and memberNo != ''">member_no,</if>
            <if test="memberName != null and memberName != ''">member_name,</if>
            <if test="phone != null">phone,</if>
            <if test="level != null and level != ''">level,</if>
            <if test="discount != null">discount,</if>
            <if test="points != null">points,</if>
            <if test="balance != null">balance,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="memberNo != null and memberNo != ''">#{memberNo},</if>
            <if test="memberName != null and memberName != ''">#{memberName},</if>
            <if test="phone != null">#{phone},</if>
            <if test="level != null and level != ''">#{level},</if>
            <if test="discount != null">#{discount},</if>
            <if test="points != null">#{points},</if>
            <if test="balance != null">#{balance},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateJxcMember" parameterType="JxcMember">
        update jxc_member
        <trim prefix="SET" suffixOverrides=",">
            <if test="memberNo != null and memberNo != ''">member_no = #{memberNo},</if>
            <if test="memberName != null and memberName != ''">member_name = #{memberName},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="level != null and level != ''">level = #{level},</if>
            <if test="discount != null">discount = #{discount},</if>
            <if test="points != null">points = #{points},</if>
            <if test="balance != null">balance = #{balance},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteJxcMemberById" parameterType="Long">
        delete from jxc_member where id = #{id}
    </delete>

    <delete id="deleteJxcMemberByIds" parameterType="String">
        delete from jxc_member where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>