<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.jxc.mapper.JxcSaleOrderMapper">
    
    <resultMap type="JxcSaleOrder" id="JxcSaleOrderResult">
        <result property="id"    column="id"    />
        <result property="saleNo"    column="sale_no"    />
        <result property="memberId"    column="member_id"    />
        <result property="saleDate"    column="sale_date"    />
        <result property="totalAmount"    column="total_amount"    />
        <result property="discountAmount"    column="discount_amount"    />
        <result property="actualAmount"    column="actual_amount"    />
        <result property="receivedAmount"    column="received_amount"    />
        <result property="payType"    column="pay_type"    />
        <result property="payStatus"    column="pay_status"    />
        <result property="status"    column="status"    />
        <result property="auditBy"    column="audit_by"    />
        <result property="auditTime"    column="audit_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <resultMap id="JxcSaleOrderJxcSaleOrderItemResult" type="JxcSaleOrder" extends="JxcSaleOrderResult">
        <collection property="jxcSaleOrderItemList" ofType="JxcSaleOrderItem" column="id" select="selectJxcSaleOrderItemList" />
    </resultMap>

    <resultMap type="JxcSaleOrderItem" id="JxcSaleOrderItemResult">
        <result property="id"    column="id"    />
        <result property="saleId"    column="sale_id"    />
        <result property="rowNo"    column="row_no"    />
        <result property="productId"    column="product_id"    />
        <result property="batchNo"    column="batch_no"    />
        <result property="quantity"    column="quantity"    />
        <result property="price"    column="price"    />
        <result property="amount"    column="amount"    />
        <result property="costPrice"    column="cost_price"    />
        <result property="costAmount"    column="cost_amount"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectJxcSaleOrderVo">
        select id, sale_no, member_id, sale_date, total_amount, discount_amount, actual_amount, received_amount, pay_type, pay_status, status, audit_by, audit_time, create_by, create_time, update_by, update_time, remark from jxc_sale_order
    </sql>

    <select id="selectJxcSaleOrderList" parameterType="JxcSaleOrder" resultMap="JxcSaleOrderResult">
        <include refid="selectJxcSaleOrderVo"/>
        <where>  
            <if test="saleNo != null  and saleNo != ''"> and sale_no = #{saleNo}</if>
            <if test="memberId != null "> and member_id = #{memberId}</if>
            <if test="saleDate != null "> and sale_date = #{saleDate}</if>
            <if test="totalAmount != null "> and total_amount = #{totalAmount}</if>
            <if test="discountAmount != null "> and discount_amount = #{discountAmount}</if>
            <if test="actualAmount != null "> and actual_amount = #{actualAmount}</if>
            <if test="receivedAmount != null "> and received_amount = #{receivedAmount}</if>
            <if test="payType != null  and payType != ''"> and pay_type = #{payType}</if>
            <if test="payStatus != null  and payStatus != ''"> and pay_status = #{payStatus}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="auditBy != null  and auditBy != ''"> and audit_by = #{auditBy}</if>
            <if test="auditTime != null "> and audit_time = #{auditTime}</if>
        </where>
    </select>
    
    <select id="selectJxcSaleOrderById" parameterType="Long" resultMap="JxcSaleOrderJxcSaleOrderItemResult">
        select id, sale_no, member_id, sale_date, total_amount, discount_amount, actual_amount, received_amount, pay_type, pay_status, status, audit_by, audit_time, create_by, create_time, update_by, update_time, remark
        from jxc_sale_order
        where id = #{id}
    </select>

    <select id="selectJxcSaleOrderItemList" resultMap="JxcSaleOrderItemResult">
        select id, sale_id, row_no, product_id, batch_no, quantity, price, amount, cost_price, cost_amount, create_by, create_time, update_by, update_time, remark
        from jxc_sale_order_item
        where sale_id = #{sale_id}
    </select>

    <select id="countTodaySaleOrders" resultType="int">
        select count(*) from jxc_sale_order where sale_no like concat('XS', #{today}, '%')
    </select>

    <insert id="insertJxcSaleOrder" parameterType="JxcSaleOrder" useGeneratedKeys="true" keyProperty="id">
        insert into jxc_sale_order
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="saleNo != null and saleNo != ''">sale_no,</if>
            <if test="memberId != null">member_id,</if>
            <if test="saleDate != null">sale_date,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="discountAmount != null">discount_amount,</if>
            <if test="actualAmount != null">actual_amount,</if>
            <if test="receivedAmount != null">received_amount,</if>
            <if test="payType != null and payType != ''">pay_type,</if>
            <if test="payStatus != null and payStatus != ''">pay_status,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="auditBy != null">audit_by,</if>
            <if test="auditTime != null">audit_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="saleNo != null and saleNo != ''">#{saleNo},</if>
            <if test="memberId != null">#{memberId},</if>
            <if test="saleDate != null">#{saleDate},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="discountAmount != null">#{discountAmount},</if>
            <if test="actualAmount != null">#{actualAmount},</if>
            <if test="receivedAmount != null">#{receivedAmount},</if>
            <if test="payType != null and payType != ''">#{payType},</if>
            <if test="payStatus != null and payStatus != ''">#{payStatus},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="auditBy != null">#{auditBy},</if>
            <if test="auditTime != null">#{auditTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateJxcSaleOrder" parameterType="JxcSaleOrder">
        update jxc_sale_order
        <trim prefix="SET" suffixOverrides=",">
            <if test="saleNo != null and saleNo != ''">sale_no = #{saleNo},</if>
            <if test="memberId != null">member_id = #{memberId},</if>
            <if test="saleDate != null">sale_date = #{saleDate},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="discountAmount != null">discount_amount = #{discountAmount},</if>
            <if test="actualAmount != null">actual_amount = #{actualAmount},</if>
            <if test="receivedAmount != null">received_amount = #{receivedAmount},</if>
            <if test="payType != null and payType != ''">pay_type = #{payType},</if>
            <if test="payStatus != null and payStatus != ''">pay_status = #{payStatus},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="auditBy != null">audit_by = #{auditBy},</if>
            <if test="auditTime != null">audit_time = #{auditTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteJxcSaleOrderById" parameterType="Long">
        delete from jxc_sale_order where id = #{id}
    </delete>

    <delete id="deleteJxcSaleOrderByIds" parameterType="String">
        delete from jxc_sale_order where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
    <delete id="deleteJxcSaleOrderItemBySaleIds" parameterType="String">
        delete from jxc_sale_order_item where sale_id in 
        <foreach item="saleId" collection="array" open="(" separator="," close=")">
            #{saleId}
        </foreach>
    </delete>

    <delete id="deleteJxcSaleOrderItemBySaleId" parameterType="Long">
        delete from jxc_sale_order_item where sale_id = #{saleId}
    </delete>

    <insert id="batchJxcSaleOrderItem">
        insert into jxc_sale_order_item( id, sale_id, row_no, product_id, batch_no, quantity, price, amount, cost_price, cost_amount, create_by, create_time, update_by, update_time, remark) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.id}, #{item.saleId}, #{item.rowNo}, #{item.productId}, #{item.batchNo}, #{item.quantity}, #{item.price}, #{item.amount}, #{item.costPrice}, #{item.costAmount}, #{item.createBy}, #{item.createTime}, #{item.updateBy}, #{item.updateTime}, #{item.remark})
        </foreach>
    </insert>
</mapper>