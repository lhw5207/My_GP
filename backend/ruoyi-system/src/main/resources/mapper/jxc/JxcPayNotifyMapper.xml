<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.jxc.mapper.JxcPayNotifyMapper">

    <resultMap type="JxcPayNotify" id="JxcPayNotifyResult">
        <result property="id"    column="id"    />
        <result property="outTradeNo"    column="out_trade_no"    />
        <result property="channel"    column="channel"    />
        <result property="tradeNo"    column="trade_no"    />
        <result property="amount"    column="amount"    />
        <result property="buyerId"    column="buyer_id"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectJxcPayNotifyVo">
        select id, out_trade_no, channel, trade_no, amount, buyer_id, status, create_by, create_time, update_by, update_time, remark from jxc_pay_notify
    </sql>

    <select id="selectJxcPayNotifyById" parameterType="Long" resultMap="JxcPayNotifyResult">
        <include refid="selectJxcPayNotifyVo"/>
        where id = #{id}
    </select>

    <select id="selectJxcPayNotifyList" parameterType="JxcPayNotify" resultMap="JxcPayNotifyResult">
        <include refid="selectJxcPayNotifyVo"/>
        <where>
            <if test="outTradeNo != null  and outTradeNo != ''"> and out_trade_no = #{outTradeNo}</if>
            <if test="channel != null  and channel != ''"> and channel = #{channel}</if>
            <if test="tradeNo != null  and tradeNo != ''"> and trade_no = #{tradeNo}</if>
            <if test="amount != null "> and amount = #{amount}</if>
        </where>
        order by id desc
    </select>

    <insert id="insertJxcPayNotify" parameterType="JxcPayNotify" useGeneratedKeys="true" keyProperty="id">
        insert into jxc_pay_notify
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="outTradeNo != null and outTradeNo != ''">out_trade_no,</if>
            <if test="channel != null and channel != ''">channel,</if>
            <if test="tradeNo != null">trade_no,</if>
            <if test="amount != null">amount,</if>
            <if test="buyerId != null">buyer_id,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="outTradeNo != null and outTradeNo != ''">#{outTradeNo},</if>
            <if test="channel != null and channel != ''">#{channel},</if>
            <if test="tradeNo != null">#{tradeNo},</if>
            <if test="amount != null">#{amount},</if>
            <if test="buyerId != null">#{buyerId},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>
</mapper>
