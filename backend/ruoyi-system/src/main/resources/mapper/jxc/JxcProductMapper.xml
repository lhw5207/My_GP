<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.jxc.mapper.JxcProductMapper">
    
    <resultMap type="JxcProduct" id="JxcProductResult">
        <result property="id"    column="id"    />
        <result property="categoryId"    column="category_id"    />
        <result property="productCode"    column="product_code"    />
        <result property="productName"    column="product_name"    />
        <result property="barcode"    column="barcode"    />
        <result property="unit"    column="unit"    />
        <result property="spec"    column="spec"    />
        <result property="purchasePrice"    column="purchase_price"    />
        <result property="salePrice"    column="sale_price"    />
        <result property="stockMin"    column="stock_min"    />
        <result property="stockMax"    column="stock_max"    />
        <result property="shelfLifeDays"    column="shelf_life_days"    />
        <result property="enableBatch"    column="enable_batch"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectJxcProductVo">
        select id, category_id, product_code, product_name, barcode, unit, spec, purchase_price, sale_price, stock_min, stock_max, shelf_life_days, enable_batch, status, create_by, create_time, update_by, update_time, remark from jxc_product
    </sql>

    <select id="selectJxcProductList" parameterType="JxcProduct" resultMap="JxcProductResult">
        <include refid="selectJxcProductVo"/>
        <where>  
            <if test="categoryId != null "> and category_id = #{categoryId}</if>
            <if test="productCode != null  and productCode != ''"> and product_code = #{productCode}</if>
            <if test="productName != null  and productName != ''"> and product_name like concat('%', #{productName}, '%')</if>
            <if test="barcode != null  and barcode != ''"> and barcode = #{barcode}</if>
            <if test="unit != null  and unit != ''"> and unit = #{unit}</if>
            <if test="spec != null  and spec != ''"> and spec = #{spec}</if>
            <if test="purchasePrice != null "> and purchase_price = #{purchasePrice}</if>
            <if test="salePrice != null "> and sale_price = #{salePrice}</if>
            <if test="stockMin != null "> and stock_min = #{stockMin}</if>
            <if test="stockMax != null "> and stock_max = #{stockMax}</if>
            <if test="shelfLifeDays != null "> and shelf_life_days = #{shelfLifeDays}</if>
            <if test="enableBatch != null  and enableBatch != ''"> and enable_batch = #{enableBatch}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectJxcProductById" parameterType="Long" resultMap="JxcProductResult">
        <include refid="selectJxcProductVo"/>
        where id = #{id}
    </select>

    <insert id="insertJxcProduct" parameterType="JxcProduct" useGeneratedKeys="true" keyProperty="id">
        insert into jxc_product
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="categoryId != null">category_id,</if>
            <if test="productCode != null and productCode != ''">product_code,</if>
            <if test="productName != null and productName != ''">product_name,</if>
            <if test="barcode != null">barcode,</if>
            <if test="unit != null and unit != ''">unit,</if>
            <if test="spec != null">spec,</if>
            <if test="purchasePrice != null">purchase_price,</if>
            <if test="salePrice != null">sale_price,</if>
            <if test="stockMin != null">stock_min,</if>
            <if test="stockMax != null">stock_max,</if>
            <if test="shelfLifeDays != null">shelf_life_days,</if>
            <if test="enableBatch != null and enableBatch != ''">enable_batch,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="categoryId != null">#{categoryId},</if>
            <if test="productCode != null and productCode != ''">#{productCode},</if>
            <if test="productName != null and productName != ''">#{productName},</if>
            <if test="barcode != null">#{barcode},</if>
            <if test="unit != null and unit != ''">#{unit},</if>
            <if test="spec != null">#{spec},</if>
            <if test="purchasePrice != null">#{purchasePrice},</if>
            <if test="salePrice != null">#{salePrice},</if>
            <if test="stockMin != null">#{stockMin},</if>
            <if test="stockMax != null">#{stockMax},</if>
            <if test="shelfLifeDays != null">#{shelfLifeDays},</if>
            <if test="enableBatch != null and enableBatch != ''">#{enableBatch},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateJxcProduct" parameterType="JxcProduct">
        update jxc_product
        <trim prefix="SET" suffixOverrides=",">
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="productCode != null and productCode != ''">product_code = #{productCode},</if>
            <if test="productName != null and productName != ''">product_name = #{productName},</if>
            <if test="barcode != null">barcode = #{barcode},</if>
            <if test="unit != null and unit != ''">unit = #{unit},</if>
            <if test="spec != null">spec = #{spec},</if>
            <if test="purchasePrice != null">purchase_price = #{purchasePrice},</if>
            <if test="salePrice != null">sale_price = #{salePrice},</if>
            <if test="stockMin != null">stock_min = #{stockMin},</if>
            <if test="stockMax != null">stock_max = #{stockMax},</if>
            <if test="shelfLifeDays != null">shelf_life_days = #{shelfLifeDays},</if>
            <if test="enableBatch != null and enableBatch != ''">enable_batch = #{enableBatch},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteJxcProductById" parameterType="Long">
        delete from jxc_product where id = #{id}
    </delete>

    <delete id="deleteJxcProductByIds" parameterType="String">
        delete from jxc_product where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>