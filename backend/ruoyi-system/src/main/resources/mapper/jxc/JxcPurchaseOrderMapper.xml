<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.jxc.mapper.JxcPurchaseOrderMapper">
    
    <resultMap type="JxcPurchaseOrder" id="JxcPurchaseOrderResult">
        <result property="id"    column="id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="supplierId"    column="supplier_id"    />
        <result property="orderDate"    column="order_date"    />
        <result property="totalAmount"    column="total_amount"    />
        <result property="status"    column="status"    />
        <result property="auditBy"    column="audit_by"    />
        <result property="auditTime"    column="audit_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <resultMap id="JxcPurchaseOrderJxcPurchaseOrderItemResult" type="JxcPurchaseOrder" extends="JxcPurchaseOrderResult">
        <collection property="jxcPurchaseOrderItemList" ofType="JxcPurchaseOrderItem" column="id" select="selectJxcPurchaseOrderItemList" />
    </resultMap>

    <resultMap type="JxcPurchaseOrderItem" id="JxcPurchaseOrderItemResult">
        <result property="id"    column="id"    />
        <result property="orderId"    column="order_id"    />
        <result property="rowNo"    column="row_no"    />
        <result property="productId"    column="product_id"    />
        <result property="quantity"    column="quantity"    />
        <result property="price"    column="price"    />
        <result property="amount"    column="amount"    />
        <result property="receivedQty"    column="received_qty"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectJxcPurchaseOrderVo">
        select id, order_no, supplier_id, order_date, total_amount, status, audit_by, audit_time, create_by, create_time, update_by, update_time, remark from jxc_purchase_order
    </sql>

    <select id="selectJxcPurchaseOrderList" parameterType="JxcPurchaseOrder" resultMap="JxcPurchaseOrderResult">
        <include refid="selectJxcPurchaseOrderVo"/>
        <where>  
            <if test="orderNo != null  and orderNo != ''"> and order_no = #{orderNo}</if>
            <if test="supplierId != null "> and supplier_id = #{supplierId}</if>
            <if test="orderDate != null "> and order_date = #{orderDate}</if>
            <if test="totalAmount != null "> and total_amount = #{totalAmount}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="auditBy != null  and auditBy != ''"> and audit_by = #{auditBy}</if>
            <if test="auditTime != null "> and audit_time = #{auditTime}</if>
        </where>
    </select>
    
    <select id="selectJxcPurchaseOrderById" parameterType="Long" resultMap="JxcPurchaseOrderJxcPurchaseOrderItemResult">
        select id, order_no, supplier_id, order_date, total_amount, status, audit_by, audit_time, create_by, create_time, update_by, update_time, remark
        from jxc_purchase_order
        where id = #{id}
    </select>

    <select id="selectJxcPurchaseOrderItemList" resultMap="JxcPurchaseOrderItemResult">
        select id, order_id, row_no, product_id, quantity, price, amount, received_qty, create_by, create_time, update_by, update_time, remark
        from jxc_purchase_order_item
        where order_id = #{order_id}
    </select>

    <insert id="insertJxcPurchaseOrder" parameterType="JxcPurchaseOrder" useGeneratedKeys="true" keyProperty="id">
        insert into jxc_purchase_order
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">order_no,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="orderDate != null">order_date,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="auditBy != null">audit_by,</if>
            <if test="auditTime != null">audit_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">#{orderNo},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="orderDate != null">#{orderDate},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="auditBy != null">#{auditBy},</if>
            <if test="auditTime != null">#{auditTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateJxcPurchaseOrder" parameterType="JxcPurchaseOrder">
        update jxc_purchase_order
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">order_no = #{orderNo},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="orderDate != null">order_date = #{orderDate},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="auditBy != null">audit_by = #{auditBy},</if>
            <if test="auditTime != null">audit_time = #{auditTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteJxcPurchaseOrderById" parameterType="Long">
        delete from jxc_purchase_order where id = #{id}
    </delete>

    <delete id="deleteJxcPurchaseOrderByIds" parameterType="String">
        delete from jxc_purchase_order where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
    <delete id="deleteJxcPurchaseOrderItemByOrderIds" parameterType="String">
        delete from jxc_purchase_order_item where order_id in 
        <foreach item="orderId" collection="array" open="(" separator="," close=")">
            #{orderId}
        </foreach>
    </delete>

    <delete id="deleteJxcPurchaseOrderItemByOrderId" parameterType="Long">
        delete from jxc_purchase_order_item where order_id = #{orderId}
    </delete>

    <insert id="batchJxcPurchaseOrderItem">
        insert into jxc_purchase_order_item( id, order_id, row_no, product_id, quantity, price, amount, received_qty, create_by, create_time, update_by, update_time, remark) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.id}, #{item.orderId}, #{item.rowNo}, #{item.productId}, #{item.quantity}, #{item.price}, #{item.amount}, #{item.receivedQty}, #{item.createBy}, #{item.createTime}, #{item.updateBy}, #{item.updateTime}, #{item.remark})
        </foreach>
    </insert>
</mapper>