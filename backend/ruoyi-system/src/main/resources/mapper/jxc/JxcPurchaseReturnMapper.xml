<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.jxc.mapper.JxcPurchaseReturnMapper">
    
    <resultMap type="JxcPurchaseReturn" id="JxcPurchaseReturnResult">
        <result property="id"    column="id"    />
        <result property="returnNo"    column="return_no"    />
        <result property="supplierId"    column="supplier_id"    />
        <result property="sourceInNo"    column="source_in_no"    />
        <result property="returnDate"    column="return_date"    />
        <result property="totalAmount"    column="total_amount"    />
        <result property="status"    column="status"    />
        <result property="auditBy"    column="audit_by"    />
        <result property="auditTime"    column="audit_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <resultMap id="JxcPurchaseReturnJxcPurchaseReturnItemResult" type="JxcPurchaseReturn" extends="JxcPurchaseReturnResult">
        <collection property="jxcPurchaseReturnItemList" ofType="JxcPurchaseReturnItem" column="id" select="selectJxcPurchaseReturnItemList" />
    </resultMap>

    <resultMap type="JxcPurchaseReturnItem" id="JxcPurchaseReturnItemResult">
        <result property="id"    column="id"    />
        <result property="returnId"    column="return_id"    />
        <result property="rowNo"    column="row_no"    />
        <result property="productId"    column="product_id"    />
        <result property="batchNo"    column="batch_no"    />
        <result property="quantity"    column="quantity"    />
        <result property="price"    column="price"    />
        <result property="amount"    column="amount"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectJxcPurchaseReturnVo">
        select id, return_no, supplier_id, source_in_no, return_date, total_amount, status, audit_by, audit_time, create_by, create_time, update_by, update_time, remark from jxc_purchase_return
    </sql>

    <select id="selectJxcPurchaseReturnList" parameterType="JxcPurchaseReturn" resultMap="JxcPurchaseReturnResult">
        <include refid="selectJxcPurchaseReturnVo"/>
        <where>  
            <if test="returnNo != null  and returnNo != ''"> and return_no = #{returnNo}</if>
            <if test="supplierId != null "> and supplier_id = #{supplierId}</if>
            <if test="sourceInNo != null  and sourceInNo != ''"> and source_in_no = #{sourceInNo}</if>
            <if test="returnDate != null "> and return_date = #{returnDate}</if>
            <if test="totalAmount != null "> and total_amount = #{totalAmount}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="auditBy != null  and auditBy != ''"> and audit_by = #{auditBy}</if>
            <if test="auditTime != null "> and audit_time = #{auditTime}</if>
        </where>
    </select>
    
    <select id="selectJxcPurchaseReturnById" parameterType="Long" resultMap="JxcPurchaseReturnJxcPurchaseReturnItemResult">
        select id, return_no, supplier_id, source_in_no, return_date, total_amount, status, audit_by, audit_time, create_by, create_time, update_by, update_time, remark
        from jxc_purchase_return
        where id = #{id}
    </select>

    <select id="selectJxcPurchaseReturnItemList" resultMap="JxcPurchaseReturnItemResult">
        select id, return_id, row_no, product_id, batch_no, quantity, price, amount, create_by, create_time, update_by, update_time, remark
        from jxc_purchase_return_item
        where return_id = #{return_id}
    </select>

    <insert id="insertJxcPurchaseReturn" parameterType="JxcPurchaseReturn" useGeneratedKeys="true" keyProperty="id">
        insert into jxc_purchase_return
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="returnNo != null and returnNo != ''">return_no,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="sourceInNo != null">source_in_no,</if>
            <if test="returnDate != null">return_date,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="auditBy != null">audit_by,</if>
            <if test="auditTime != null">audit_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="returnNo != null and returnNo != ''">#{returnNo},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="sourceInNo != null">#{sourceInNo},</if>
            <if test="returnDate != null">#{returnDate},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="auditBy != null">#{auditBy},</if>
            <if test="auditTime != null">#{auditTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateJxcPurchaseReturn" parameterType="JxcPurchaseReturn">
        update jxc_purchase_return
        <trim prefix="SET" suffixOverrides=",">
            <if test="returnNo != null and returnNo != ''">return_no = #{returnNo},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="sourceInNo != null">source_in_no = #{sourceInNo},</if>
            <if test="returnDate != null">return_date = #{returnDate},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="auditBy != null">audit_by = #{auditBy},</if>
            <if test="auditTime != null">audit_time = #{auditTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteJxcPurchaseReturnById" parameterType="Long">
        delete from jxc_purchase_return where id = #{id}
    </delete>

    <delete id="deleteJxcPurchaseReturnByIds" parameterType="String">
        delete from jxc_purchase_return where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
    <delete id="deleteJxcPurchaseReturnItemByReturnIds" parameterType="String">
        delete from jxc_purchase_return_item where return_id in 
        <foreach item="returnId" collection="array" open="(" separator="," close=")">
            #{returnId}
        </foreach>
    </delete>

    <delete id="deleteJxcPurchaseReturnItemByReturnId" parameterType="Long">
        delete from jxc_purchase_return_item where return_id = #{returnId}
    </delete>

    <insert id="batchJxcPurchaseReturnItem">
        insert into jxc_purchase_return_item( id, return_id, row_no, product_id, batch_no, quantity, price, amount, create_by, create_time, update_by, update_time, remark) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.id}, #{item.returnId}, #{item.rowNo}, #{item.productId}, #{item.batchNo}, #{item.quantity}, #{item.price}, #{item.amount}, #{item.createBy}, #{item.createTime}, #{item.updateBy}, #{item.updateTime}, #{item.remark})
        </foreach>
    </insert>
</mapper>