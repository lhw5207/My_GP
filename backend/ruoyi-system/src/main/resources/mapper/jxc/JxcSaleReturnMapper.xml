<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.jxc.mapper.JxcSaleReturnMapper">
    
    <resultMap type="JxcSaleReturn" id="JxcSaleReturnResult">
        <result property="id"    column="id"    />
        <result property="returnNo"    column="return_no"    />
        <result property="sourceSaleNo"    column="source_sale_no"    />
        <result property="memberId"    column="member_id"    />
        <result property="returnDate"    column="return_date"    />
        <result property="totalAmount"    column="total_amount"    />
        <result property="refundAmount"    column="refund_amount"    />
        <result property="status"    column="status"    />
        <result property="auditBy"    column="audit_by"    />
        <result property="auditTime"    column="audit_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <resultMap id="JxcSaleReturnJxcSaleReturnItemResult" type="JxcSaleReturn" extends="JxcSaleReturnResult">
        <collection property="jxcSaleReturnItemList" ofType="JxcSaleReturnItem" column="id" select="selectJxcSaleReturnItemList" />
    </resultMap>

    <resultMap type="JxcSaleReturnItem" id="JxcSaleReturnItemResult">
        <result property="id"    column="id"    />
        <result property="returnId"    column="return_id"    />
        <result property="rowNo"    column="row_no"    />
        <result property="productId"    column="product_id"    />
        <result property="batchNo"    column="batch_no"    />
        <result property="quantity"    column="quantity"    />
        <result property="price"    column="price"    />
        <result property="amount"    column="amount"    />
        <result property="costPrice"    column="cost_price"    />
        <result property="costAmount"    column="cost_amount"    />
        <result property="sourceSaleItemId"    column="source_sale_item_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectJxcSaleReturnVo">
        select id, return_no, source_sale_no, member_id, return_date, total_amount, refund_amount, status, audit_by, audit_time, create_by, create_time, update_by, update_time, remark from jxc_sale_return
    </sql>

    <select id="selectJxcSaleReturnList" parameterType="JxcSaleReturn" resultMap="JxcSaleReturnResult">
        <include refid="selectJxcSaleReturnVo"/>
        <where>  
            <if test="returnNo != null  and returnNo != ''"> and return_no = #{returnNo}</if>
            <if test="sourceSaleNo != null  and sourceSaleNo != ''"> and source_sale_no = #{sourceSaleNo}</if>
            <if test="memberId != null "> and member_id = #{memberId}</if>
            <if test="returnDate != null "> and return_date = #{returnDate}</if>
            <if test="totalAmount != null "> and total_amount = #{totalAmount}</if>
            <if test="refundAmount != null "> and refund_amount = #{refundAmount}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="auditBy != null  and auditBy != ''"> and audit_by = #{auditBy}</if>
            <if test="auditTime != null "> and audit_time = #{auditTime}</if>
        </where>
    </select>
    
    <select id="selectJxcSaleReturnById" parameterType="Long" resultMap="JxcSaleReturnJxcSaleReturnItemResult">
        select id, return_no, source_sale_no, member_id, return_date, total_amount, refund_amount, status, audit_by, audit_time, create_by, create_time, update_by, update_time, remark
        from jxc_sale_return
        where id = #{id}
    </select>

    <select id="selectJxcSaleReturnItemList" resultMap="JxcSaleReturnItemResult">
        select id, return_id, row_no, product_id, batch_no, quantity, price, amount, cost_price, cost_amount, source_sale_item_id, create_by, create_time, update_by, update_time, remark
        from jxc_sale_return_item
        where return_id = #{return_id}
    </select>

    <insert id="insertJxcSaleReturn" parameterType="JxcSaleReturn" useGeneratedKeys="true" keyProperty="id">
        insert into jxc_sale_return
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="returnNo != null and returnNo != ''">return_no,</if>
            <if test="sourceSaleNo != null">source_sale_no,</if>
            <if test="memberId != null">member_id,</if>
            <if test="returnDate != null">return_date,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="refundAmount != null">refund_amount,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="auditBy != null">audit_by,</if>
            <if test="auditTime != null">audit_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="returnNo != null and returnNo != ''">#{returnNo},</if>
            <if test="sourceSaleNo != null">#{sourceSaleNo},</if>
            <if test="memberId != null">#{memberId},</if>
            <if test="returnDate != null">#{returnDate},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="refundAmount != null">#{refundAmount},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="auditBy != null">#{auditBy},</if>
            <if test="auditTime != null">#{auditTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateJxcSaleReturn" parameterType="JxcSaleReturn">
        update jxc_sale_return
        <trim prefix="SET" suffixOverrides=",">
            <if test="returnNo != null and returnNo != ''">return_no = #{returnNo},</if>
            <if test="sourceSaleNo != null">source_sale_no = #{sourceSaleNo},</if>
            <if test="memberId != null">member_id = #{memberId},</if>
            <if test="returnDate != null">return_date = #{returnDate},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="refundAmount != null">refund_amount = #{refundAmount},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="auditBy != null">audit_by = #{auditBy},</if>
            <if test="auditTime != null">audit_time = #{auditTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteJxcSaleReturnById" parameterType="Long">
        delete from jxc_sale_return where id = #{id}
    </delete>

    <delete id="deleteJxcSaleReturnByIds" parameterType="String">
        delete from jxc_sale_return where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
    <delete id="deleteJxcSaleReturnItemByReturnIds" parameterType="String">
        delete from jxc_sale_return_item where return_id in 
        <foreach item="returnId" collection="array" open="(" separator="," close=")">
            #{returnId}
        </foreach>
    </delete>

    <delete id="deleteJxcSaleReturnItemByReturnId" parameterType="Long">
        delete from jxc_sale_return_item where return_id = #{returnId}
    </delete>

    <insert id="batchJxcSaleReturnItem">
        insert into jxc_sale_return_item( id, return_id, row_no, product_id, batch_no, quantity, price, amount, cost_price, cost_amount, source_sale_item_id, create_by, create_time, update_by, update_time, remark) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.id}, #{item.returnId}, #{item.rowNo}, #{item.productId}, #{item.batchNo}, #{item.quantity}, #{item.price}, #{item.amount}, #{item.costPrice}, #{item.costAmount}, #{item.sourceSaleItemId}, #{item.createBy}, #{item.createTime}, #{item.updateBy}, #{item.updateTime}, #{item.remark})
        </foreach>
    </insert>
</mapper>